[global]
monitor = 0
follow = mouse

width = 320
height = (0, 100)

origin = top-right
offset = (20, 20)
scale = 0

padding = 12
horizontal_padding = 12
frame_width = 1
separator_height = 0

font = JetBrainsMono Nerd Font 10
markup = yes
format = "<b>%s</b>\n%b"

alignment = left
word_wrap = yes
ellipsize = middle

# Nord Dark
background = "#2E3440"
foreground = "#D8DEE9"
frame_color = "#88C0D0"
separator_color = frame

# Catppuccin Mocha
# background = "#1e1e2e"
# foreground = "#cdd6f4"
# frame_color = "#cba6f7"
# separator_color = frame

idle_threshold = 120
timeout = 5
corner_radius = 0

[urgency_low]
# Nord Dark
background = "#2E3440"
foreground = "#D8DEE9"
frame_color = "#88C0D0"

# Catppuccin Mocha
# background = "#1e1e2e"
# foreground = "#cdd6f4"
# frame_color = "#cba6f7"
# timeout = 4

[urgency_normal]
# Nord Dark
background = "#2E3440"
foreground = "#D8DEE9"
frame_color = "#88C0D0"

# Catppuccin Mocha
# background = "#1e1e2e"
# foreground = "#cdd6f4"
# frame_color = "#cba6f7"
timeout = 6

[urgency_critical]
# Nord Dark
background = "#2E3440"
foreground = "#BF616A"
frame_color = "#BF616A"

# Catppuccin Mocha
# background = "#1e1e2e"
# foreground = "#f38ba8"
# frame_color = "#f38ba8"
timeout = 0
