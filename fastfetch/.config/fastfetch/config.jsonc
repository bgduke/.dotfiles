{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // "logo": {
  //   "type": "auto",
  //   "padding": {
  //     "right": 2
  //   }
  // },

  "logo": {
    "source": "~/.config/fastfetch/creeper_inverted.txt",
    "padding": { "top": 3, "left": 6, "right": 6 }
  },

  "display": {
    "separator": " ➜ ",
    "pipe": false
  },

  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────────OS────────────────────┐"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "  󰏖 Pkgs",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└───────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────Software─────────────────┐"
    },
    {
      "type": "wm",
      "key": "  󰖯 WM"
    },
    {
      "type": "shell",
      "key": "   Shell"
    },
    {
      "type": "terminal",
      "key": "   Term"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└───────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────Hardware──────────────────┐"
    },
    {
      "type": "cpu",
      "key": "  󰍛 CPU",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "hideType": "integrated",
      "key": "  󰍹 GPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "  󰑭 RAM",
      "format": "{used}/{total} ({percentage}%)",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└───────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
