" VsVim config for Visual Studio 2026
" Adapted from ideavim/.ideavimrc.

" ============================================================
" Leader Keys
" ============================================================

let mapleader = " "
let maplocalleader = " "

" ============================================================
" Core Settings
" ============================================================

set nocompatible
set number
set relativenumber
set cursorline

set hlsearch
set incsearch
set ignorecase
set smartcase

set scrolloff=8
set sidescrolloff=8
set nowrap

set tabstop=4
set shiftwidth=4
set expandtab

set clipboard=unnamed
set visualbell

" Let Visual Studio own editor behavior that VsVim does not emulate directly.
set vsvim_useeditordefaults

" IdeaVim-only options intentionally omitted:
" VimEverywhere, clipboard+=ideaput, surround, commentary, highlightedyank,
" ideajoin, and idearefactormode.

" ============================================================
" General
" ============================================================

map <C-c> <Esc>

" Clear search highlight. IdeaVim uses <leader>h for Call Hierarchy, so keep
" this on a nearby non-conflicting binding.
nnoremap <leader><Esc> :nohlsearch<CR>

" Zen Mode / Focus
nnoremap <C-z> :vsc View.FullScreen<CR>

" ============================================================
" Windows
" ============================================================

nnoremap <leader>e  :vsc View.SolutionExplorer<CR>
nnoremap <leader>g  :vsc View.GitChanges<CR>
nnoremap <leader>d  :vsc View.ErrorList<CR>
nnoremap <leader>r  :vsc Edit.QuickActions<CR>
nnoremap <leader>t  :vsc View.Terminal<CR>
nnoremap <leader>a  :vsc View.GitHubCopilotChat<CR>
nnoremap <leader>nu :vsc Project.ManageNuGetPackages<CR>

" ============================================================
" Window / Split Navigation
" ============================================================

" Visual Studio exposes pane cycling rather than Vim-style directional panes.
nnoremap <C-h> :vsc Window.PreviousPane<CR>
nnoremap <C-j> :vsc Window.NextPane<CR>
nnoremap <C-k> :vsc Window.PreviousPane<CR>
nnoremap <C-l> :vsc Window.NextPane<CR>

nnoremap <leader>sv :vsc Window.NewVerticalTabGroup<CR>
nnoremap <leader>sh :vsc Window.NewHorizontalTabGroup<CR>

nnoremap <C-m> :vsc Window.MoveToNextTabGroup<CR>

" ============================================================
" Tabs / Editors
" ============================================================

nnoremap <S-h> :vsc Window.PreviousDocumentWindow<CR>
nnoremap <S-l> :vsc Window.NextDocumentWindow<CR>
nnoremap <leader><space> :vsc Window.ShowEzMDIFileList<CR>
nnoremap <leader>q :vsc Window.CloseDocumentWindow<CR>

" ============================================================
" Folding
" ============================================================

nnoremap zc :vsc Edit.CollapseCurrentRegion<CR>
nnoremap zo :vsc Edit.ExpandCurrentRegion<CR>

nnoremap <leader>zc :vsc Edit.CollapseCurrentRegion<CR>
nnoremap <leader>zo :vsc Edit.ExpandCurrentRegion<CR>

nnoremap <leader>zC :vsc Edit.CollapseAllOutlining<CR>
nnoremap <leader>zO :vsc Edit.ToggleAllOutlining<CR>

" ============================================================
" Editing
" ============================================================

vnoremap < <gv
vnoremap > >gv

nnoremap [[ :vsc Edit.PreviousMethod<CR>
nnoremap ]] :vsc Edit.NextMethod<CR>
nnoremap <leader>c :vsc Edit.ToggleLineComment<CR>
nnoremap <leader>F :vsc Edit.FormatDocument<CR>

nnoremap <leader>r  :vsc Edit.QuickActions<CR>
nnoremap <leader>rr :vsc Refactor.Rename<CR>
nnoremap <leader>ca :vsc Edit.QuickActions<CR>

nnoremap <leader>=  :vsc Edit.FormatDocument<CR>
nnoremap <leader>o  :vsc Edit.RemoveAndSort<CR>

nnoremap <leader>l  :vsc View.NavigateBackward<CR>
nnoremap <C-r>      :vsc Edit.GoToRecentFile<CR>

nnoremap <leader>hh :vsc View.History<CR>

" ============================================================
" Navigation / Search
" ============================================================

nnoremap <C-s> :vsc Edit.GoToSymbol<CR>

nnoremap [[ :vsc Edit.PreviousMethod<CR>
nnoremap ]] :vsc Edit.NextMethod<CR>

nnoremap <leader>ff :vsc Edit.GoToFile<CR>
nnoremap <leader>fs :vsc Edit.GoToSymbol<CR>
nnoremap <leader>fa :vsc Edit.GoToAll<CR>
nnoremap <leader>/  :vsc Edit.FindinFiles<CR>
nnoremap <leader>sr :vsc Edit.ReplaceinFiles<CR>

nnoremap <leader>s :vsc Edit.GoToAll<CR>
nnoremap <leader>b :vsc View.NavigateBackward<CR>
nnoremap <leader>h :vsc View.CallHierarchy<CR>

" Go-to
nnoremap gd :vsc Edit.GoToDefinition<CR>
nnoremap gD :vsc Edit.GoToTypeDefinition<CR>
nnoremap gi :vsc Edit.GoToImplementation<CR>
nnoremap gc :vsc Edit.GoToFile<CR>
nnoremap gt :vsc TestExplorer.ShowTestExplorer<CR>
nnoremap gp :vsc Edit.GoToBase<CR>

" Usages
nnoremap gr :vsc Edit.FindAllReferences<CR>

" Navigation History
nnoremap <C-i> :vsc View.NavigateForward<CR>
nnoremap <C-o> :vsc View.NavigateBackward<CR>

" Diagnostics
nnoremap ge :vsc Edit.GoToNextLocation<CR>
nnoremap gE :vsc Edit.GoToPrevLocation<CR>

" ============================================================
" Project / Files / VCS
" ============================================================

nnoremap <leader>w  :vsc File.SaveSelectedItems<CR>
nnoremap <leader>W  :vsc File.SaveAll<CR>
nnoremap <leader>e  :vsc View.SolutionExplorer<CR>

nnoremap <leader>gg :vsc View.GitChanges<CR>
nnoremap <leader>dd :vsc View.ErrorList<CR>

nnoremap <leader>hp :vsc Help.ViewHelp<CR>

" ============================================================
" Debugger
" ============================================================

nnoremap <F5>  :vsc Debug.Start<CR>
nnoremap <F10> :vsc Debug.StepOver<CR>
nnoremap <F11> :vsc Debug.StepInto<CR>
nnoremap <F12> :vsc Debug.StepOut<CR>

nnoremap <leader>db :vsc Debug.ToggleBreakpoint<CR>
nnoremap <leader>dB :vsc Debug.Windows.Breakpoints<CR>

nnoremap <leader>dr :vsc Debug.Windows.Autos<CR>
nnoremap <leader>dt :vsc Debug.StopDebugging<CR>

nnoremap <leader>dh :vsc Debug.QuickWatch<CR>
nnoremap <leader>de :vsc Debug.ExceptionSettings<CR>

" ============================================================
" Build
" ============================================================

nnoremap <leader>bp :vsc Build.BuildSelection<CR>
nnoremap <leader>bs :vsc Build.BuildSolution<CR>
nnoremap <leader>br :vsc Build.RebuildSolution<CR>

" ============================================================
" Testing
" ============================================================

nnoremap <leader>tr :vsc TestExplorer.RunAllTestsInView<CR>
nnoremap <leader>td :vsc TestExplorer.DebugAllTestsInView<CR>

nnoremap <leader>tR :vsc TestExplorer.RunAllTests<CR>
nnoremap <leader>tT :vsc TestExplorer.ShowTestExplorer<CR>
nnoremap <leader>tf :vsc TestExplorer.RunFailedTests<CR>

" ============================================================
" Insert Mode
" ============================================================

" Keep completion ownership with Visual Studio/IntelliSense.
" If you prefer IdeaVim-style Tab cycling, uncomment these:
" inoremap <Tab>   <C-N>
" inoremap <S-Tab> <C-P>

" ============================================================
" VsVim Config
" ============================================================

nnoremap <leader>ce :e ~/.vsvimrc<CR>
nnoremap <leader>cr :source ~/.vsvimrc<CR>
