     4 +let mapleader = " "
     5 +let maplocalleader = " "
     6 +
     7 +" Core behavior
     8 +set number
     9 +set relativenumber
    10 +set hlsearch
    11 +set incsearch
    12 +set ignorecase
    13 +set smartcase
    14 +set scrolloff=8
    15 +set sidescrolloff=8
    16 +set clipboard+=unnamed
    17 +set clipboard+=ideaput
    18 +set surround
    19 +set commentary
    20 +set highlightedyank
    21 +set ideajoin
    22 +set idearefactormode=keep
    23 +
    24 +" Window navigation
    25 +nnoremap <C-h> <C-w>h
    26 +nnoremap <C-j> <C-w>j
    27 +nnoremap <C-k> <C-w>k
    28 +nnoremap <C-l> <C-w>l
    36 +nnoremap <leader>zc <Action>(CollapseRegion)
    37 +nnoremap <leader>zo <Action>(ExpandRegion)
    38 +nnoremap <leader>zC <Action>(CollapseAllRegions)
    39 +nnoremap <leader>zO <Action>(ExpandAllRegions)
    40 +
    41 +" Tabs/editors: use Rider editor tabs as the closest buffer equivalent
    42 +nnoremap <S-h> <Action>(PreviousTab)
    43 +nnoremap <S-l> <Action>(NextTab)
    44 +nnoremap <leader><space> <Action>(Switcher)
    45 +nnoremap <leader>q <Action>(CloseContent)
    46 +nnoremap <leader>sv <Action>(SplitVertically)
    47 +nnoremap <leader>sh <Action>(SplitHorizontally)
    48 +
    49 +" Project/files/search
    50 +nnoremap <leader>e <Action>(ActivateProjectToolWindow)
    51 +nnoremap <leader>gg <Action>(Vcs.QuickListPopupAction)
    52 +nnoremap <leader>ff <Action>(GotoFile)
    53 +nnoremap <leader>/ <Action>(FindInPath)
    54 +nnoremap <leader>dd <Action>(GotoNextError)
    55 +nnoremap <leader>sr <Action>(ReplaceInPath)
    56 +nnoremap <leader>hh <Action>(HelpTopics)
    57 +
    63 +nnoremap gD <Action>(GotoTypeDeclaration)
    64 +nnoremap gr <Action>(FindUsages)
    65 +nnoremap <leader>ca <Action>(ShowIntentionActions)
    66 +nnoremap <leader>rr <Action>(RenameElement)
    67 +nnoremap <leader>kp <Action>(ReformatCode)
    68 +nnoremap <leader>gv :action SplitVertically<CR>:action GotoDeclaration<CR>
    69 +
    70 +" Debugger: replace nvim-dap mappings with Rider debugger actions
    71 +nnoremap <F5> <Action>(Resume)
    72 +nnoremap <F10> <Action>(StepOver)
    73 +nnoremap <F11> <Action>(StepInto)
    74 +nnoremap <F12> <Action>(StepOut)
    75 +nnoremap <leader>db <Action>(ToggleLineBreakpoint)
    76 +nnoremap <leader>dB <Action>(ViewBreakpoints)
    77 +nnoremap <leader>dl <Action>(ViewBreakpoints)
    78 +nnoremap <leader>dr <Action>(ActivateDebugToolWindow)
    79 +nnoremap <leader>du <Action>(ActivateDebugToolWindow)
    80 +nnoremap <leader>dt <Action>(Stop)
    81 +nnoremap <leader>dh <Action>(QuickEvaluateExpression)
    82 +nnoremap <leader>de <Action>(ViewBreakpoints)
    83 +
    84 +" .NET/test workflow: best-effort Rider-native replacements for easy-dotnet usage
    85 +nnoremap <leader>r <Action>(RunContextTest)
    86 +nnoremap <leader>t <Action>(RunAllTests)
    87 +nnoremap <leader>d <Action>(DebugContextTest)
    88 +nnoremap <leader>R <Action>(RerunTests)
    89 +nnoremap <leader>p <Action>(ActivateRunToolWindow)
    90 +nnoremap <leader>pu <Action>(NuGet.ManagePackages)
    91 +nnoremap <leader>pa <Action>(NuGet.ManagePackages)
    92 +
    93 +" Insert-mode convenience: keep popup completion navigation muscle memory
    94 +inoremap <S-Tab> <C-P>
    95 +inoremap <Tab> <C-N>
